SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# PostgreSQL connection string
DATABASE_URL=postgresql://sahatak_user:sahatak_pass@localhost:5432/sahatak_db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ============================================
# n8n Webhook Configuration (ADDED)
# ============================================

# Enable/disable webhook firing to n8n
# Set to 'false' initially, 'true' after n8n workflows are created
N8N_WEBHOOK_ENABLED=false

# Shared secret for HMAC-SHA256 signature verification
# ⚠️ IMPORTANT: Use a strong, random string (at least 32 characters)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
N8N_WEBHOOK_SECRET=your-webhook-secret-change-this-to-something-random

# Webhook URLs (leave empty until workflows are created in n8n.cloud)
# These will be provided by n8n when you create each workflow
N8N_WEBHOOK_ERROR_HANDLER=
N8N_WEBHOOK_APPOINTMENT_CREATED=
N8N_WEBHOOK_APPOINTMENT_STATUS_CHANGED=
N8N_WEBHOOK_DOCTOR_VERIFIED=
N8N_WEBHOOK_AUDIT_LOG=
N8N_WEBHOOK_NOTIFICATION=
