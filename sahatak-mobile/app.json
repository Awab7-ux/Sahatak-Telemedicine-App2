{
  "expo": {
    "name": "Sahatak Telemedicine",
    "slug": "sahatak-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0284c7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahatak.telemedicine",
      "infoPlist": {
        "NSCameraUsageDescription": "Sahatak needs camera access so you can take and upload a profile photo.",
        "NSPhotoLibraryUsageDescription": "Sahatak needs photo library access so you can select and upload a profile photo."
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you choose a profile picture.",
          "cameraPermission": "The app accesses your camera to let you capture a profile picture."
        }
      ]
    ],
    "android": {
      "package": "com.sahatak.telemedicine",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0284c7"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "416801b7-f7aa-4a32-9819-f8924d98eb15"
      }
    }
  }
}
